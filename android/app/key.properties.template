# CampusConnect — release (direct-distribution) signing credentials — TEMPLATE.
#
# v9.2.4 (C-1). Copy this file to `android/app/key.properties`, fill in the
# four values, and keep the real file OFFLINE. Do NOT commit it.
#
# Deployment scope: the signed release APK is installed **directly** on the demo
# device. This project is not published to Google Play, so this is a
# direct-distribution release key rather than a Play upload key — see
# `docs/Task.md` §0. The key material is identical either way.
#
#   copy android\app\key.properties.template android\app\key.properties
#
# `android/.gitignore` already excludes `key.properties` and every
# `*.jks` / `*.keystore`, so a filled-in copy can never be staged by accident.
# `functions/test/hardening_source_contracts.test.js` additionally fails the
# Functions test suite if a real `key.properties` (or keystore) is ever present
# in the working tree.
#
# See `docs/release_signing.md` for the full keystore generation, backup and
# rotation procedure, and for how `android/app/build.gradle.kts` consumes these
# keys.
#
# ---------------------------------------------------------------------------
# storeFile
#   Absolute path, or a path relative to `android/app/`, to the release keystore
#   created with `keytool`. Example:
#     storeFile=C:/keys/campusconnect-release.jks
#     storeFile=release-keystore.jks       (a file next to this template)
#
# storePassword
#   The keystore password chosen at `keytool -genkeypair` time.
#
# keyAlias
#   The alias of the release key inside the keystore. `upload` is a conventional
#   alias name and is what the examples in docs/release_signing.md use; the alias
#   itself is arbitrary as long as it matches this file.
#
# keyPassword
#   The password for that alias. It may equal `storePassword`, but a distinct
#   value is preferred.
# ---------------------------------------------------------------------------

storeFile=C:/keys/campusconnect-upload.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=upload
keyPassword=CHANGE_ME_KEY_PASSWORD
