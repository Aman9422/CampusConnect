{
  "name": "campusconnect-functions",
  "description": "Firebase Cloud Functions for CampusConnect",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test \"test/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project campusconnect-firebase-project \"node --test test-rules/firestore_rules.test.js\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project campusconnect-firebase-project \"node --test test-rules/storage_rules.test.js\"",
    "test:all-rules": "firebase emulators:exec --only firestore,storage --project campusconnect-firebase-project \"node --test --test-concurrency=1 test-rules/firestore_rules.test.js test-rules/storage_rules.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
