rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================
    // HELPER FUNCTIONS
    // ===============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================
    // USERS COLLECTION (with subcollections)
    // ===============================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      
      // v6.5: AI Insights (read-only, Cloud Functions write)
      match /ai_insights/{insightId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions can write
      }
      
      // v6.8: Resume Review History
      match /resumeReviews/{reviewId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }
      
      // All other subcollections under users/{uid}
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================
    // PLACEMENTS (READ-ONLY FOR USERS)
    // ===============================================
    match /placements/{placementId} {
      allow read: if isAuthenticated();
      allow write: if false;

      // Applications under placements
      match /applications/{appUserId} {
        allow create: if isOwner(appUserId);
        allow read: if isOwner(appUserId);
        allow update, delete: if false;
      }
    }

    // ===============================================
    // GLOBAL APPLICATIONS COLLECTION
    // ===============================================
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ===============================================
    // NOTES (SHARED RESOURCES)
    // ===============================================
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===============================================
    // AI FEATURES (READ-ONLY FOR USER)
    // ===============================================
    match /ai_conversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /ai_usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /ai_rate_limits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /ai_spam_check/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ===============================================
    // ANALYTICS (ADMIN ONLY)
    // ===============================================
    match /analytics_events/{eventId} {
      allow read, write: if false;
    }

    // ===============================================
    // ANNOUNCEMENTS (v6.4 - Admin broadcasts)
    // ===============================================
    match /announcements/{announcementId} {
      // All authenticated users can read announcements
      allow read: if isAuthenticated();
      // Only admin can write (via console/admin SDK)
      allow write: if false;
    }

    // ===============================================
    // DENY EVERYTHING ELSE
    // ===============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
