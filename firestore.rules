rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================
    // HELPER FUNCTIONS
    // ===============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // M3: Guarded with exists() — get() throws (denying the request) when the
    // requesting user's doc is missing or lacks a role field.
    function userRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function canManagePlacements() {
      return isAuthenticated() &&
        (userRole() == 'teacher' || userRole() == 'alumni');
    }

    function isTeacher() {
      return isAuthenticated() && userRole() == 'teacher';
    }

    // v9.1: Alumni manage placements, and application docs are
    // placement-scoped — grant alumni the same read access teachers have on
    // the `applications` collectionGroup + placement mirror subcollection.
    function isAlumni() {
      return isAuthenticated() && userRole() == 'alumni';
    }

    // F1 (security): Users may NEVER change their `role` once it has been
    // persisted on their document. Role is chosen once at registration and is
    // effectively immutable to the client afterwards — role changes must go
    // through Cloud Functions/admin (see register_view.dart saveRole and
    // profile_setup_view.dart _completeSetup for the legitimate paths).
    //
    // A write is allowed when:
    //   - the document does not exist yet (first-time role persistence during
    //     registration), or
    //   - the existing document has no `role` field yet (fallback path where
    //     the role was held only in-memory when currentUser was transiently
    //     null post-registration), or
    //   - the role value is unchanged.
    //
    // This closes the privilege-escalation hole where a signed-in student
    // could set their own `role` to 'teacher'/'alumni' and thereby gain read
    // access to every user document (PII), every resume and all analytics.
    function canWriteRole(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId))
          || !('role' in resource.data)
          || !('role' in request.resource.data)
          || resource.data.role == request.resource.data.role;
    }

    // v9.1 audit (SEC-1): schema validation for placement writes. Applies to
    // BOTH create and update — `request.resource.data` is the post-write
    // (merged-for-update) document, so the same full-schema check works for
    // both. The `createdBy == request.auth.uid` binding is enforced here so
    // a manager can never forge a placement authored by someone else, and
    // malformed placement docs (the SEC-1 client DoS vector) are rejected
    // server-side.
    function isValidPlacementData() {
      return request.resource.data.deadline is timestamp &&
             request.resource.data.postedAt is timestamp &&
             request.resource.data.isActive is bool &&
             request.resource.data.createdBy == request.auth.uid &&
             request.resource.data.company is string &&
             request.resource.data.company.size() > 0 &&
             request.resource.data.role is string &&
             request.resource.data.role.size() > 0 &&
             request.resource.data.description is string &&
             request.resource.data.description.size() > 0 &&
             request.resource.data.eligibility is string &&
             request.resource.data.eligibility.size() > 0 &&
             request.resource.data.salary is string &&
             request.resource.data.salary.size() > 0;
    }

    // ===============================================
    // USERS COLLECTION (with subcollections)
    // ===============================================
    match /users/{userId} {
      // Users can always read/write their own profile, except their
      // immutable `role` field (canWriteRole guard — see F1 above).
      allow read, write: if isOwner(userId) && canWriteRole(userId);
      // v8.1: Teachers can read any user profile for analytics
      allow read: if isTeacher();
      // v8.4: Alumni read-only access to student portfolios
      // (read-only — never write) so alumni can view a student's portfolio
      // from a mentorship request context.
      // M2 (privacy note): the portfolio is a nested map on the user
      // document, so this grants alumni read access to the WHOLE student doc
      // (phone, email, academic data) — not just the portfolio. This is a
      // deliberate trade-off of the nested-map design; moving the portfolio
      // to a subcollection would be an architecture change (out of scope).
      allow read: if isAuthenticated() &&
        userRole() == 'alumni' &&
        resource.data.role == 'student';
      // v7.2: Alumni directory - authenticated users can read alumni profiles
      allow read: if isAuthenticated() &&
        resource.data.role == 'alumni' &&
        resource.data.profileCompleted == true;
      
      // Notifications subcollection
      // v7.3: Enhanced - allow system notifications creation
      // F7 (security): creation is owner-only. System notifications
      // (placement status changes, announcements, etc.) are written by the
      // Cloud Functions Admin SDK, which bypasses security rules entirely —
      // so tightening this does not break system notifications.
      // v8.4.2 (S5a/L4): allow owner deletes — the UI exposes swipe-to-delete
      // (NotificationsProvider.deleteNotification) and "Clear read
      // notifications" (clearReadNotifications), both of which previously
      // threw permission-denied.
      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // v6.5: AI Insights (read-only, Cloud Functions write)
      match /ai_insights/{insightId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions can write
      }

      // v7.4: AI interaction history (career assistant)
      // v8.8 (P5): owner deletes allowed — the user can clear their own AI
      // chat history (AIChatProvider.deleteHistory → Firestore delete).
      // Identity is `request.auth.uid` (isOwner), so another user's
      // ai_interactions can never be deleted. update stays false — history
      // is append-only; edits go through the delete+resave path.
      match /ai_interactions/{interactionId} {
        allow read, create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      // v7.4: Recommendation feed (Cloud Functions managed)
      match /recommendations/{recommendationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // v7.4: Recommendation metadata (Cloud Functions managed)
      match /recommendations_meta/{metaId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // v7.4: Engagement score summary (Cloud Functions / service managed)
      // v8.2: Teachers can read any student's engagement summary for analytics
      match /engagement_summary/{summaryId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if false;
      }

      // v7.4: User activity log
      // v8.8.3 (MED-5): create is OWNER-ONLY AND restricts the payload to the
      // sole legitimate client write — the Resume Reviewer logs a
      // `resumeReviewed` activity worth exactly 5 points (ResumeReviewProvider
      // on success). A client forging arbitrary `points` or event types
      // (e.g. 99999 points, or many `chatMessageSent` events) can no longer
      // self-award the Active Student / Networking Pro badges. The server's
      // own `logUserActivity` uses the Admin SDK and bypasses rules, so the
      // engagement/recommendation pipeline is unaffected.
      match /activities/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.eventType == 'resumeReviewed' &&
          request.resource.data.points == 5;
        allow update, delete: if false;
      }
      
      // v6.8: Resume Review History
      // v6.95: Added aiAnalysis, aiGeneratedAt, aiProviderUsed fields
      //        (written by Cloud Function generateResumeAnalysis)
      // v8.1: Teachers can read any student's resume reviews for analytics
      match /resumeReviews/{reviewId} {
        allow read: if isOwner(userId) || isTeacher();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }

      // v9.0: Career Coach analysis (Cloud Functions managed)
      // Owner can read; write is server-only (Admin SDK) to enforce the
      // single-writer + quota contract. Prevents clients from bypassing
      // the AI + quota system by writing directly to the summary doc.
      match /career_coach/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // All other subcollections under users/{uid}
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================
    // PLACEMENTS (READ-ONLY FOR USERS)
    // ===============================================
    match /placements/{placementId} {
      allow read: if isAuthenticated();
      // v9.1 audit (SEC-1): managers may create (with schema + createdBy
      // binding) and update/delete ONLY placements they authored. An
      // unrestricted `canManagePlacements()` allowed any teacher/alumni to
      // delete every placement or write malformed docs that crashed every
      // client rendering the list.
      allow create: if canManagePlacements() && isValidPlacementData();
      allow update: if canManagePlacements() &&
        resource.data.createdBy == request.auth.uid &&
        isValidPlacementData();
      allow delete: if canManagePlacements() &&
        resource.data.createdBy == request.auth.uid;

      // Applications under placements
      // v9.1: alumni may read the placement mirror docs (they manage
      // placements and application docs are placement-scoped).
      // v9.1 audit (SEC-2): create is LOCKED (`false`) on both application
      // paths — `logPlacementApplication` uses the Admin SDK and bypasses
      // rules, so clients never need direct create. Previously `create` was
      // open, letting students forge docs with arbitrary status/resumeUrl
      // (self-promotion + phishing-resume chain). Updates/deletes go
      // through `updateApplicationStatus` (Admin SDK).
      match /applications/{appUserId} {
        allow create: if false;
        allow read: if isOwner(appUserId) || isAlumni() || isTeacher();
        allow update, delete: if false;
      }
    }

    // ===============================================
    // GLOBAL APPLICATIONS COLLECTION
    // ===============================================
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // v9.1 audit (SEC-2): create is LOCKED on BOTH application paths —
      // `logPlacementApplication` uses the Admin SDK and bypasses rules, so
      // clients never need direct create. Previously `create` was open
      // (`userId == request.auth.uid`), letting students forge docs with
      // arbitrary `status` and `resumeUrl` (self-promotion + phishing-resume
      // chain, arbitrary placementId pollution).
      allow create: if false;
      allow update, delete: if false;
    }

    // ===============================================
    // NOTES (SHARED RESOURCES)
    // Students: read-only
    // Teachers: full CRUD
    // ===============================================
    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && userRole() == 'teacher';
      allow update, delete: if isAuthenticated() && userRole() == 'teacher';
    }

    // ===============================================
    // AI FEATURES (READ-ONLY FOR USER)
    // ===============================================
    match /ai_conversations/{conversationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /ai_usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /ai_rate_limits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /ai_spam_check/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ===============================================
    // RESUME USAGE (Cloud Functions managed)
    // ===============================================
    match /resume_usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // ===============================================
    // v9.0: CAREER COACH USAGE (Cloud Functions managed)
    // ===============================================
    match /career_coach_usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions can write
    }

    // ===============================================
    // ANALYTICS (ADMIN ONLY)
    // ===============================================
    match /analytics_events/{eventId} {
      allow read, write: if false;
    }

    // ===============================================
    // ANNOUNCEMENTS (v6.4 - Admin broadcasts)
    // ===============================================
    match /announcements/{announcementId} {
      // All authenticated users can read announcements
      allow read: if isAuthenticated();
      // Only admin can write (via console/admin SDK)
      allow write: if false;
    }

    // ===============================================
    // MULTI-ROLE ECOSYSTEM (v7.2)
    // ===============================================

    // Mentorship requests - students create, alumni respond, both can complete
    match /mentorship_requests/{requestId} {
      allow read: if isAuthenticated() &&
        (resource.data.studentId == request.auth.uid ||
         resource.data.alumniId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (
          // Alumni can respond to requests
          (resource.data.alumniId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'respondedAt', 'responseMessage', 'chatId'])) ||
          // Both participants can mark as completed (v7.3)
          ((resource.data.studentId == request.auth.uid ||
            resource.data.alumniId == request.auth.uid) &&
           request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'completedAt', 'rating', 'feedback']))
        );
      allow delete: if isAuthenticated() &&
        resource.data.studentId == request.auth.uid;
    }

    // Job opportunities - alumni create, all authenticated users can read
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.alumniId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.alumniId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.alumniId == request.auth.uid;
    }

    // Alumni directory - handled in users collection above ✓

    // ===============================================
    // PUBLIC ALUMNI PROFILES (v7.4 optional)
    // ===============================================
    match /public_profiles/{profileKey} {
      // Public docs are readable by anyone; owners can always read their own doc.
      allow read: if resource.data.isPublic == true ||
        (isAuthenticated() && resource.data.uid == request.auth.uid);

      // Alumni can create/update/delete only their own public profile projection.
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.profileKey == profileKey;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.profileKey == profileKey;
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    // ===============================================
    // REAL-TIME CHAT SYSTEM (v7.3)
    // ===============================================

    // Chat conversations - only participants can access
    // v8.8.3 (MED-4): a participant may READ the chat and UPDATE only the
    // last-message/unread metadata (`lastMessage`, `lastMessageSenderId`,
    // `lastMessageAt`, `unreadCount`) that `ChatService.sendMessage` /
    // `markAsRead` write. Full-document rewrite (participants/mentorshipId
    // tampering) and DELETE are denied to clients — deleting a chat or
    // rewriting its identity fields requires the Admin SDK (ChatService
    // `deleteChat`, which has no UI caller, uses the server path only).
    match /chats/{chatId} {
      // Participants can read their chats
      allow read: if isAuthenticated() &&
                   request.auth.uid in resource.data.participantIds;

      // Participants may update ONLY messaging metadata — not identity.
      allow update: if isAuthenticated() &&
                    request.auth.uid in resource.data.participantIds &&
                    (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessage', 'lastMessageSenderId',
                                  'lastMessageAt', 'unreadCount']));

      // No client delete — chat removal is Admin SDK only.
      allow delete: if false;

      // For creating chats, check if user is in the participant list
      allow create: if isAuthenticated() &&
                    request.auth.uid in request.resource.data.participantIds;

      // Chat messages subcollection
      match /messages/{messageId} {
        // Only participants can read/write messages
        allow read, write: if isAuthenticated() &&
                            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isAuthenticated() &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // ===============================================
    // v8.1: TEACHER ANALYTICS — collectionGroup queries
    // Allow teachers to query resume reviews across all users
    // for aggregate analytics (stats, skill gaps, trends).
    // ===============================================
    match /{path=**}/resumeReviews/{reviewId} {
      allow read: if isTeacher();
    }

    // ===============================================
    // v8.9 (Phase 8/14): TEACHER ANALYTICS — collectionGroup for
    // recommendations. Teachers may read students' RECOMMENDATION docs for
    // aggregate intelligence (career goals, target roles, skill gaps,
    // placement match distribution). Recommendation docs contain only the
    // engine fields — role/targetRole, skills, reason, scores — never
    // private resume text or full student profiles. Students remain the
    // only writers (write:false everywhere) and owners retain read.
    // ===============================================
    match /{path=**}/recommendations/{recommendationId} {
      allow read: if isTeacher();
    }

    // ===============================================
    // v8.2.1: TEACHER ANALYTICS — collectionGroup for applications
    // Allow teachers to count applications across all placements
    // for pipeline analytics.
    // ===============================================
    match /{path=**}/applications/{appId} {
      // v9.1: alumni added — alumni manage placements and application docs
      // are placement-scoped. Teachers/alumni read via collectionGroup
      // queries (`getApplicationsForPlacement`, `getApplicantCounts`).
      // v9.1 audit (SEC-5): the owner side of the read rule now checks the
      // DOCUMENT's `userId` field instead of the doc-ID `appId` — canonical
      // doc IDs are `{uid}_{placementId}` so `isOwner(appId)` was always
      // false. `resource.data.userId == request.auth.uid` is the correct
      // owner check and works for BOTH canonical and mirror docs.
      allow read: if isTeacher() || isAlumni() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ===============================================
    // v8.7: ALUMNI GROUP CHAT — alumni-only shared group
    // ===============================================
    // Single shared group for verified Alumni. Students, Teachers and
    // unauthenticated users are denied read and write. The sender UID must
    // equal the authenticated user's UID (never trust a client-supplied
    // senderId — Task §8). Users may only update/delete (soft-delete) their
    // own messages.
    match /alumni_group_messages/{messageId} {
      allow read: if isAuthenticated() && userRole() == 'alumni';
      allow create: if isAuthenticated() && userRole() == 'alumni' &&
        request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && userRole() == 'alumni' &&
        resource.data.senderId == request.auth.uid;
    }

    // ===============================================
    // DENY EVERYTHING ELSE
    // ===============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
