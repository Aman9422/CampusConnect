rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // v8.4: Resume PDF storage
    // Layout: resumes/{uid}/latest.pdf
    // (the {fileName} wildcard also covers future history/ paths)
    match /resumes/{userId}/{fileName} {
      // Owner can upload/overwrite/delete their own resume.
      // H2: Enforce PDF-only + 5 MB limit server-side so malicious/buggy
      // clients cannot write arbitrary content types or oversized files.
      // C1: `request.resource` is null on delete — the null branch permits
      // owner deletes; the `<=` boundary matches the client validator (L3).
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        (request.resource == null ||
         (request.resource.contentType.matches('application/pdf') &&
          request.resource.size <= 5 * 1024 * 1024));

      // Owner + teachers + alumni can read resumes (teachers/alumni
      // view student portfolios read-only).
      // C3: User roles live in Firestore, not auth tokens — the previous
      // `request.auth.token.role` branch was always false and teachers got
      // permission-denied. Use the same Firestore role lookup as
      // firestore.rules, guarded with exists().
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'alumni']);
    }

    // v9.2 audit (INT-1): immutable placement resume snapshots.
    //
    // `logPlacementApplication` copies the applied resume to
    // `resumes/{uid}/snapshots/app_{applicationId}.pdf` — TWO path segments
    // after `uid`. The single-segment `match /resumes/{userId}/{fileName}`
    // above therefore did NOT cover it, so it fell through to the deny-all
    // and was reachable ONLY through the long-lived signed URL stored in the
    // application doc (signed URLs bypass Storage rules). This grants the
    // same read access as a live resume so the snapshot can be read by path
    // (owner / teacher / alumni) without relying on the signed URL.
    //
    // Snapshots are write-once: only the Admin SDK (Cloud Functions) creates
    // or removes them, so client write is denied.
    //
    // NOTE (signed-URL expiry): `logPlacementApplication` still stores a
    // signed URL (expiring 2035) in the application doc and the client UI
    // currently opens that URL. Because the path is now rule-covered, a
    // future change can drop to short-lived, on-demand URLs minted by an
    // authenticated teacher/alumni path with no further rule change.
    match /resumes/{userId}/snapshots/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'alumni']);
      allow write: if false;
    }

    // Deny all other files
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
